/* ===================================================================================
   SwingPulse on Google Apps Script — glue: storage (this Google Sheet), Gemini over REST,
   live prices, Telegram, the web app and the 15-minute agent trigger.
   Secrets live in Script Properties (only the owner can read them).
   =================================================================================== */

var GAS_VERSION = '6.2.1';
var DEFAULT_MODEL = 'gemini-flash-latest';
var FALLBACK_MODELS = ['gemini-flash-lite-latest', 'gemini-2.5-flash'];
var CELL_MAX = 45000;                 // a Sheets cell holds 50,000 characters; keep a margin
var STATE_KEYS = ['portfolio', 'portfolioIL', 'digest', 'settings', 'alerts', 'meta', 'orders', 'updatedAt'];

/* ---------- web app ---------- */

var ICON_URL = 'https://raw.githubusercontent.com/JudaZinger/-/main/swingpulse-icon.png';

var APP_URL = 'https://judazinger.github.io/-/swingpulse/';
var PUSH_SUBJECT = 'mailto:swingpulse@users.noreply.github.com';

/* The app lives on GitHub Pages and talks to this script through doPost with an access code.
   No HtmlService page is served, so nothing here can be called without the code. */
function doGet() {
  return ContentService.createTextOutput(JSON.stringify({ ok: true, service: 'swingpulse-apps-script', version: GAS_VERSION, app: APP_URL }))
    .setMimeType(ContentService.MimeType.JSON);
}

var RPC = {
  health: function () { return apiHealth(); },
  getState: function () { return readState_(); },
  putState: function (patch) { return setState_(patch || {}); },
  quotes: function (tickers) { return quotesWithFx_(tickers || []); },
  candles: function (ticker, range) { return getCandles_(ticker, range); },
  digest: function (portfolio, opts) { return JSON.parse(apiDigest(JSON.stringify(portfolio), opts || {})); },
  // opts.il: the Tel Aviv book, so one scan covers both markets
  extractChunk: function (images, start, total, market) { return apiExtractChunk(images, start, total, market); },
  mergeExtraction: function (chunks, meta) { return JSON.parse(apiMergeExtraction(chunks, meta)); },
  saveSecrets: function (s) { return apiSaveSecrets(s); },
  testTelegram: function () { return apiTestTelegram(); },
  savePushSub: function (sub) { return savePushSub_(sub); },
  removePushSub: function (endpoint) { return removePushSub_(endpoint); },
  testPush: function () { return testPush_(); },
  getDemo: function () { return demoView_(); },
  demoReset: function () { return demoReset_(); },
  putDemo: function (patch) {
    var p = {};
    if (patch && patch.portfolio) p.portfolio = patch.portfolio;
    if (patch && patch.portfolioIL) p.portfolioIL = patch.portfolioIL;
    if (patch && 'digest' in patch) p.digest = patch.digest;
    setDemo_(p);
    return demoView_();
  },
  parseTrade: function (text, mode) { return parseTrade_(text, mode); },
  applyTrades: function (trades, mode, source) { return applyTrades_(trades, mode, source); },
  analysts: function (ticker, mode, refresh) { return analysts_(ticker, mode, refresh); },
  placeOrder: function (order, mode) { return placeOrder_(order, mode); },
  cancelOrder: function (id, mode) { return cancelOrder_(id, mode); },
  fillOrder: function (id, mode, price) { return fillOrder_(id, mode, price); },
  latestAlerts: function () { return (readState_().alerts || []).slice(0, 5).map(function (a) { return { ticker: a.ticker, action: a.action, kind: a.kind || '', text: alertText(a), at: a.at }; }); }
};

function json_(obj) { return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON); }

function doPost(e) {
  var body;
  try { body = JSON.parse((e && e.postData && e.postData.contents) || '{}'); }
  catch (x) { return json_({ ok: false, error: { code: 'bad_request', message: 'invalid JSON' } }); }
  var want = secret_('APP_TOKEN');
  if (!want || !safeEqual_(String(body.t || ''), want)) return json_({ ok: false, error: { code: 'login_required', message: 'קוד גישה שגוי' } });
  var fn = Object.prototype.hasOwnProperty.call(RPC, body.fn) ? RPC[body.fn] : null;
  if (!fn) return json_({ ok: false, error: { code: 'bad_request', message: 'unknown function' } });
  try { return json_({ ok: true, result: fn.apply(null, body.args || []) }); }
  catch (err) {
    var raw = redact_(String((err && err.message) || err)), info = null;
    try { info = JSON.parse(raw); } catch (x) { /* plain error */ }
    return json_({ ok: false, error: info && info.code ? info : { code: /timed out|exceeded maximum/i.test(raw) ? 'timeout' : 'server_error', message: raw.slice(0, 400) } });
  }
}

/** Never let a secret leave in an error message (a failed fetch can echo its URL, and the Telegram URL holds the bot token). */
function redact_(text) {
  ['GEMINI_API_KEY', 'TELEGRAM_BOT_TOKEN', 'APP_TOKEN', 'VAPID_PRIVATE'].forEach(function (k) {
    var v = secret_(k);
    if (v && v.length >= 8) text = text.split(v).join('***');
  });
  return text.replace(/AIza[0-9A-Za-z_\-]{20,}/g, '***').replace(/bot\d{5,}:[A-Za-z0-9_\-]{20,}/g, 'bot***');
}

function safeEqual_(a, b) {
  if (a.length !== b.length) return false;
  var d = 0;
  for (var i = 0; i < a.length; i++) d |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return d === 0;
}

/* ---------- randomness and hashing for the push keys ---------- */

function randomBytes_(n) {
  var out = [];
  while (out.length < n) {
    var seed = Utilities.getUuid() + Utilities.getUuid() + Date.now() + Math.random();
    Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, seed).forEach(function (b) { out.push(b & 255); });
  }
  return out.slice(0, n);
}
function sha256_(bytes) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, bytes.map(function (b) { return b > 127 ? b - 256 : b; }))
    .map(function (b) { return b & 255; });
}

/* ---------- web push (empty pushes; the app's service worker fetches the alert text) ---------- */

function pushSubs_() { try { return JSON.parse(secret_('PUSH_SUBS') || '[]'); } catch (e) { return []; } }
function savePushSubs_(list) { props_().setProperty('PUSH_SUBS', JSON.stringify(list.slice(-8))); }
function savePushSub_(sub) {
  if (!sub || !/^https:\/\//.test(sub.endpoint || '')) throw apiError_('bad_request', 'bad subscription');
  var list = pushSubs_().filter(function (s) { return s.endpoint !== sub.endpoint; });
  list.push({ endpoint: sub.endpoint, device: String(sub.device || '').slice(0, 60), at: new Date().toISOString() });
  savePushSubs_(list);
  return { subs: list.length };
}
function removePushSub_(endpoint) {
  savePushSubs_(pushSubs_().filter(function (s) { return s.endpoint !== endpoint; }));
  return { subs: pushSubs_().length };
}
function vapidKeys_() {
  var pk = secret_('VAPID_PRIVATE'), pub = secret_('VAPID_PUBLIC');
  if (pk && pub) return { privateKey: pk, publicKey: pub };
  var k = generateKeys(randomBytes_);
  props_().setProperties({ VAPID_PRIVATE: k.privateKey, VAPID_PUBLIC: k.publicKey });
  return k;
}
function sendPush_() {
  var subs = pushSubs_();
  if (!subs.length) return { sent: 0, subs: 0 };
  var keys = vapidKeys_(), sent = 0, keep = [];
  subs.forEach(function (s) {
    var res = UrlFetchApp.fetch(s.endpoint, { method: 'post', headers: pushHeaders(s.endpoint, keys, PUSH_SUBJECT, sha256_, randomBytes_), payload: '', muteHttpExceptions: true });
    var code = res.getResponseCode();
    if (code === 404 || code === 410) return;          // the phone unsubscribed: forget it
    keep.push(s);
    if (code >= 200 && code < 300) sent++;
    else console.warn('push ' + code + ' ' + res.getContentText().slice(0, 200));
  });
  savePushSubs_(keep);
  return { sent: sent, subs: keep.length };
}
function testPush_() {
  setState_({ alerts: [{ id: new Date().toISOString() + '-test', at: new Date().toISOString(), kind: 'test', ticker: 'SwingPulse', action: 'HOLD', from: null, text: 'בדיקה: התראות מגיעות לטלפון.', stop: null, trigger: 'test' }].concat(readState_().alerts || []) });
  var r = sendPush_();
  if (!r.subs) throw apiError_('push_off', 'אין מכשיר רשום להתראות');
  return r;
}

function account_() {
  var e = '';
  try { e = Session.getEffectiveUser().getEmail() || ''; } catch (x) { /* no email scope */ }
  if (!e) { try { e = SpreadsheetApp.getActiveSpreadsheet().getOwner().getEmail() || ''; } catch (x) { /* not available */ } }
  return e;
}

/** The spreadsheet that holds the portfolio: name and link, for the account badge in the app. */
function sheetInfo_() {
  try { var ss = SpreadsheetApp.getActiveSpreadsheet(); return { name: ss.getName(), url: ss.getUrl() }; }
  catch (x) { return { name: '', url: '' }; }
}

function testAccount() { console.log('account=' + account_()); }

/* ---------- storage: one hidden sheet "_state", one row per key, JSON split over cells ---------- */

function stateSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('_state');
  if (!sh) { sh = ss.insertSheet('_state'); sh.hideSheet(); }
  return sh;
}

function readState_() {
  var sh = stateSheet_();
  var values = sh.getDataRange().getValues();
  var out = { portfolio: null, portfolioIL: null, digest: null, settings: mergeSettings({}), alerts: [], meta: {}, updatedAt: null };
  values.forEach(function (row) {
    var key = row[0];
    if (STATE_KEYS.indexOf(key) < 0) return;
    var json = row.slice(1).join('');
    if (!json) return;
    try { out[key] = JSON.parse(json); } catch (e) { /* corrupt cell: keep default */ }
  });
  out.settings = mergeSettings(out.settings);
  return out;
}

function writeKey_(sh, key, value) {
  var json = JSON.stringify(value === undefined ? null : value);
  var parts = [];
  for (var i = 0; i < json.length; i += CELL_MAX) parts.push(json.slice(i, i + CELL_MAX));
  if (!parts.length) parts.push('null');
  var keys = sh.getLastRow() ? sh.getRange(1, 1, sh.getLastRow(), 1).getValues().map(function (r) { return r[0]; }) : [];
  var rowIdx = keys.indexOf(key) + 1;
  if (!rowIdx) rowIdx = keys.length + 1;
  var width = Math.max(sh.getLastColumn(), parts.length + 1);
  var row = [key].concat(parts);
  while (row.length < width) row.push('');
  sh.getRange(rowIdx, 1, 1, width).setNumberFormat('@').setValues([row]);
}

/**
 * Write state under the script lock. `patch` may be a function: it gets the state as it is NOW (inside the lock)
 * and returns the patch, so the agent can never overwrite a trade the user saved a moment earlier.
 */
function setState_(patch) {
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    var st = readState_();
    if (typeof patch === 'function') { patch = patch(st); if (!patch) return st; }
    var sh = stateSheet_();
    Object.keys(patch).forEach(function (k) {
      if (STATE_KEYS.indexOf(k) < 0) return;
      var v = patch[k];
      if (k === 'settings') v = mergeSettings(v);
      if (k === 'alerts' && Array.isArray(v) && v.length > MAX_ALERTS) v = v.slice(0, MAX_ALERTS);
      st[k] = v;
      writeKey_(sh, k, v);
    });
    st.updatedAt = new Date().toISOString();
    writeKey_(sh, 'updatedAt', st.updatedAt);
    if ('portfolio' in patch || 'digest' in patch) writePortfolioSheet_(st.portfolio, st.digest);
    if ('portfolioIL' in patch || 'digest' in patch) writePortfolioSheet_(st.portfolioIL, st.digest, 'תיק ישראל');
    return st;
  } finally { lock.releaseLock(); }
}

/** A readable copy of the portfolio for the person, in the first sheet "תיק". */
function writePortfolioSheet_(portfolio, digest, sheetName) {
  if (!portfolio || !portfolio.positions) return;
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var name = sheetName || 'תיק';
  var sh = ss.getSheetByName(name) || (name === 'תיק' ? ss.insertSheet(name, 0) : ss.insertSheet(name));
  sh.setRightToLeft(true);
  var verdict = {};
  ((digest && digest.positions) || []).forEach(function (v) { verdict[v.ticker] = v; });
  var rows = [[name.indexOf('ישראל') >= 0 ? 'נייר (₪)' : 'מניה ($)', 'כמות', 'מחיר קנייה', 'מחיר', 'שווי', 'רווח %', 'שינוי יומי %', '% מהתיק', 'המלצה', 'סטופ', 'יעד']];
  portfolio.positions.forEach(function (p) {
    var v = verdict[p.ticker] || {};
    rows.push([p.ticker, p.shares, p.avgPrice, p.currentPrice, p.marketValue, p.unrealizedPnlPct,
      p.live ? p.live.dayChangePct : '', p.allocationPct, v.action ? ACTION_HE[v.action] : '', v.trailingStop || '', v.target || '']
      .map(function (x) { return x == null ? '' : x; }));
  });
  sh.clearContents();
  sh.getRange(1, 1, rows.length, rows[0].length).setValues(rows);
  sh.getRange(1, 1, 1, rows[0].length).setFontWeight('bold').setBackground('#f3f3f3');
  sh.setFrozenRows(1);
}

/* ---------- secrets & settings ---------- */

function props_() { return PropertiesService.getScriptProperties(); }
function secret_(k) { return props_().getProperty(k) || ''; }

/* ---------- HTTP helpers ---------- */

function fetchJSON_(url, opts) {
  var res = UrlFetchApp.fetch(url, Object.assign({ muteHttpExceptions: true }, opts || {}));
  var code = res.getResponseCode();
  var text = res.getContentText();
  var body = null;
  try { body = JSON.parse(text); } catch (e) { /* not JSON */ }
  return { code: code, body: body, text: text };
}

function apiError_(code, message) {
  return new Error(JSON.stringify({ code: code, message: String(message || code).slice(0, 400) }));
}

/* ---------- Gemini (REST) with retries and fallback models ---------- */

/** Model JSON, tolerant of a ```json fence around it. */
function parseJSONLoose_(text) {
  return JSON.parse(String(text).trim().replace(/^```(?:json)?\s*/i, '').replace(/\s*```$/, ''));
}

/**
 * opts.json: parse the answer (a cut-off or broken answer moves on to the next model).
 * opts.deadline: stop before Apps Script's 6-minute kill. opts.light: fewer tries (the background agent).
 */
function geminiGenerate_(request, opts) {
  opts = opts || {};
  var key = secret_('GEMINI_API_KEY');
  if (!key) throw apiError_('gemini_no_key', 'חסר מפתח Gemini. הזינו אותו בהגדרות.');
  var main = secret_('GEMINI_MODEL') || DEFAULT_MODEL;
  var chain = [main].concat(FALLBACK_MODELS.filter(function (m) { return m !== main; })).slice(0, opts.light ? 2 : 3);
  var tries = opts.light ? 1 : 3;
  var deadline = opts.deadline || (Date.now() + 5 * 60e3);
  var last = null;
  for (var mi = 0; mi < chain.length; mi++) {
    var model = chain[mi];
    for (var attempt = 1; attempt <= tries; attempt++) {
      if (deadline - Date.now() < 45e3) throw last || apiError_('timeout', 'נגמר הזמן לניתוח. נסו שוב.');
      var r = fetchJSON_('https://generativelanguage.googleapis.com/v1beta/models/' + model + ':generateContent', {
        method: 'post', contentType: 'application/json', headers: { 'x-goog-api-key': key }, payload: JSON.stringify(request)
      });
      if (r.code === 200 && r.body) {
        var cand = (r.body.candidates || [])[0] || {};
        var text = ((cand.content && cand.content.parts) || []).map(function (p) { return p.text || ''; }).join('');
        if (!text || (cand.finishReason && cand.finishReason !== 'STOP')) { last = apiError_('gemini_failed', 'תשובה חלקית מ-Gemini (' + (cand.finishReason || 'empty') + ')'); break; }
        var res = { text: text, model: model, grounding: cand.groundingMetadata || null };
        if (opts.json) {
          try { res.data = parseJSONLoose_(text); } catch (e) { last = apiError_('gemini_failed', 'Gemini החזיר תשובה לא תקינה'); break; }
        }
        return res;
      }
      var msg = (r.body && r.body.error && r.body.error.message) || r.text.slice(0, 300);
      if (r.code === 401 || r.code === 403 || /API key/i.test(msg)) throw apiError_('gemini_auth', msg);
      if (r.code === 400 || r.code === 404) { last = apiError_('gemini_failed', msg); break; }   // e.g. this model can't do search + schema
      if ([429, 500, 502, 503, 504].indexOf(r.code) < 0) throw apiError_('gemini_failed', msg);
      last = apiError_('gemini_busy', msg);
      if (/per ?day|daily/i.test(msg)) break;                                                    // a daily quota won't clear in seconds
      if (attempt < tries) Utilities.sleep(1200 * Math.pow(2, attempt - 1));
    }
  }
  throw last || apiError_('gemini_failed', 'unknown');
}

/* ---------- live prices: Yahoo chart API, Stooq quote as fallback ---------- */

function getQuotes_(tickers) {
  var list = [];
  tickers.forEach(function (t) { t = String(t).trim().toUpperCase(); if (t && list.indexOf(t) < 0) list.push(t); });
  var quotes = {}, failed = [], reqs = [], idx = [];
  list.forEach(function (t) {
    var sym = toYahoo(t);
    if (!sym) { failed.push({ ticker: t, reason: 'לא נסחר (זכות/CVR)' }); return; }
    idx.push(t);
    reqs.push({ url: 'https://query1.finance.yahoo.com/v8/finance/chart/' + encodeURIComponent(sym) + '?range=6mo&interval=1d&includePrePost=false',
      muteHttpExceptions: true, headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/130 Safari/537.36' } });
  });
  var responses = reqs.length ? UrlFetchApp.fetchAll(reqs) : [];
  var retry = [];
  responses.forEach(function (res, i) {
    var t = idx[i];
    try {
      if (res.getResponseCode() !== 200) throw new Error('HTTP ' + res.getResponseCode());
      quotes[t] = Object.assign({ symbol: toYahoo(t), source: 'yahoo' }, parseChart(JSON.parse(res.getContentText())));
    } catch (e) { retry.push(t); }
  });
  // fallback for whatever Yahoo refused: Stooq's latest quote (no moving averages)
  if (retry.length) {
    var sreq = retry.map(function (t) {
      // Stooq only knows US listings as .us: a foreign suffix (.TA) is asked as is
      var sym = toYahoo(t).toLowerCase();
      var st = /\.[a-z]+$/.test(sym) ? sym : sym.replace(/-/g, '.') + '.us';
      return { url: 'https://stooq.com/q/l/?s=' + encodeURIComponent(st) + '&f=sd2t2ohlcp&h&e=json', muteHttpExceptions: true };
    });
    UrlFetchApp.fetchAll(sreq).forEach(function (res, i) {
      var t = retry[i];
      try {
        var j = JSON.parse(res.getContentText().replace(/,\s*}/g, '}'));
        var s = (j.symbols || [])[0] || {};
        var ta = /\.TA$/i.test(toYahoo(t)), k = ta ? 0.01 : 1;   // Stooq quotes Tel Aviv in agorot too
        var price = Number(s.close) * k, prev = Number(s.previous) * k;
        if (!(price > 0)) throw new Error('no price');
        quotes[t] = { symbol: toYahoo(t), source: 'stooq', currency: ta ? 'ILS' : null, price: price, prevClose: prev > 0 ? prev : null,
          dayChangePct: prev > 0 ? Math.round((price / prev - 1) * 10000) / 100 : null, sma20: null, sma50: null, high20: null, low20: null, marketTime: null };
      } catch (e) { failed.push({ ticker: t, reason: 'אין מחיר (Yahoo ו-Stooq)' }); }
    });
  }
  return { quotes: quotes, failed: failed, at: new Date().toISOString() };
}

/** Daily/weekly candles for the stock chart. */
/** Quotes plus the live ₪/$ rate (kept in meta.fx so a failed fetch falls back to the last known rate). */
function quotesWithFx_(tickers) {
  var r = getQuotes_(tickers.concat([FX_SYMBOL]));
  var last = (readState_().meta || {}).fx;
  r.fx = fxRate(r.quotes, last);
  delete r.quotes[FX_SYMBOL];
  r.failed = (r.failed || []).filter(function (f) { return f.ticker !== FX_SYMBOL; });
  return r;
}
function allTickers_(h) {
  return [].concat(((h.portfolio || {}).positions || []), ((h.portfolioIL || {}).positions || [])).map(function (p) { return p.ticker; });
}
/** Fresh prices on both books of a holder (state or demo); each book only takes quotes in its own currency. */
function liveBooks_(h, q) {
  var out = {};
  if (h.portfolio) out.portfolio = applyLive_(h.portfolio, q.quotes, q.at);
  if (h.portfolioIL) out.portfolioIL = applyLive_(h.portfolioIL, q.quotes, q.at);
  return out;
}

function getCandles_(ticker, range) {
  var sym = toYahoo(ticker);
  if (!sym) throw apiError_('bad_request', 'לא נסחר');
  range = CANDLE_RANGES[range] ? range : '1y';
  var res = UrlFetchApp.fetch('https://query1.finance.yahoo.com/v8/finance/chart/' + encodeURIComponent(sym) + '?range=' + range + '&interval=' + CANDLE_RANGES[range] + '&includePrePost=false',
    { muteHttpExceptions: true, headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/130 Safari/537.36' } });
  if (res.getResponseCode() !== 200) throw apiError_('candles_failed', 'HTTP ' + res.getResponseCode());
  return Object.assign({ symbol: sym, range: range, interval: CANDLE_RANGES[range] }, parseCandles(JSON.parse(res.getContentText())));
}

/** Screenshot prices → live prices; shares/avgPrice stay as read from Blink. */
function applyLive_(portfolio, quotes, at) {
  var hits = 0;
  var positions = portfolio.positions.map(function (p) {
    var q = quotes[String(p.ticker).toUpperCase()];
    if (!q || !(q.price > 0) || !currencyFits(p.currency || portfolio.currency, q.currency)) return p;
    hits++;
    var shares = Number(p.shares) || 0, avg = Number(p.avgPrice) || 0;
    return Object.assign({}, p, {
      currentPrice: q.price,
      marketValue: shares ? Math.round(shares * q.price * 100) / 100 : p.marketValue,
      unrealizedPnlPct: avg ? Math.round((q.price / avg - 1) * 10000) / 100 : p.unrealizedPnlPct,
      live: q
    });
  });
  var invested = positions.reduce(function (a, p) { return a + (Number(p.marketValue) || 0); }, 0);
  var total = invested + (Number(portfolio.cashBalance) || 0);
  positions.forEach(function (p) { p.allocationPct = total ? Math.round((Number(p.marketValue) || 0) / total * 10000) / 100 : p.allocationPct; });
  positions.sort(function (a, b) { return (b.marketValue || 0) - (a.marketValue || 0); });
  return Object.assign({}, portfolio, {
    positions: positions,
    totalPortfolioValue: hits ? Math.round(total * 100) / 100 : portfolio.totalPortfolioValue,
    blinkReportedTotal: portfolio.blinkReportedTotal != null ? portfolio.blinkReportedTotal : (portfolio.totalPortfolioValue != null ? portfolio.totalPortfolioValue : null),
    liveAt: hits ? at : portfolio.liveAt,
    liveCount: hits
  });
}

/* ---------- Telegram ---------- */

function telegramEnabled_() { return !!(secret_('TELEGRAM_BOT_TOKEN') && secret_('TELEGRAM_CHAT_ID')); }
function telegramSend_(text) {
  if (!telegramEnabled_()) return false;
  var r;
  try { r = fetchJSON_('https://api.telegram.org/bot' + secret_('TELEGRAM_BOT_TOKEN') + '/sendMessage', {
    method: 'post', contentType: 'application/json',
    payload: JSON.stringify({ chat_id: secret_('TELEGRAM_CHAT_ID'), text: String(text).slice(0, 4000), disable_web_page_preview: true })
  }); } catch (e) { console.warn('telegram: ' + redact_(String(e.message || e))); return false; }
  if (r.code !== 200) console.warn('telegram ' + r.code + ' ' + r.text.slice(0, 200));
  return r.code === 200;
}
function notify_(list, settings) {
  if (!list.length) return;
  if (!settings || settings.push !== false) { try { sendPush_(); } catch (e) { console.warn('push: ' + e.message); } }
  if (!telegramEnabled_() || (settings && settings.telegram === false)) return;
  var text = list.slice(0, 10).map(alertText).join('\n\n') + (list.length > 10 ? '\n\n…ועוד ' + (list.length - 10) : '');
  telegramSend_('SwingPulse\n\n' + text);
}

/* ---------- digest ---------- */

function runDigest_(portfolioIn, gopts, ilIn) {
  var t0 = Date.now();
  var books = { portfolio: portfolioIn, portfolioIL: ilIn || null }, liveCount = 0, rate = FX_FALLBACK;
  try {
    var q = quotesWithFx_(allTickers_(books));
    rate = q.fx.rate;
    liveCount = Object.keys(q.quotes).length;
    if (liveCount) books = Object.assign(books, liveBooks_(books, q));
  } catch (e) { console.warn('digest quotes: ' + e.message); }
  var portfolio = digestInput(books.portfolio, books.portfolioIL, rate);
  var search = secret_('ENABLE_SEARCH') !== 'false';
  var call = function (withSearch) {
    var req = {
      contents: [{ role: 'user', parts: [{ text: digestPrompt(portfolio, { search: withSearch }) }] }],
      generationConfig: { responseMimeType: 'application/json', responseJsonSchema: DIGEST_SCHEMA }
    };
    if (withSearch) req.tools = [{ google_search: {} }];
    return geminiGenerate_(req, Object.assign({ json: true }, gopts || {}));
  };
  var r, usedSearch = search;
  try { r = call(search); }
  catch (e) {
    if (!search || /gemini_auth|gemini_no_key|"timeout"/.test(e.message)) throw e;
    usedSearch = false; r = call(false);
  }
  var out = validateDigest(r.data, portfolio);
  var chunks = (r.grounding && r.grounding.groundingChunks) || [];
  var seen = {};
  out.sources = chunks.filter(function (c) { return c.web && c.web.uri && !seen[c.web.uri] && (seen[c.web.uri] = true); })
    .slice(0, 12).map(function (c) { return { title: c.web.title || c.web.uri, url: c.web.uri }; });
  out.meta = { model: r.model, liveData: usedSearch, livePrices: liveCount, ms: Date.now() - t0, at: new Date().toISOString() };
  return { digest: out, portfolio: books.portfolio, portfolioIL: books.portfolioIL };
}

/* ---------- functions the page calls (google.script.run) ---------- */

function apiHealth() {
  return { ok: true, service: 'swingpulse-apps-script', version: GAS_VERSION, model: secret_('GEMINI_MODEL') || DEFAULT_MODEL,
    fallbacks: FALLBACK_MODELS, chunkSize: 6, maxFiles: 100, search: secret_('ENABLE_SEARCH') !== 'false',
    auth: true, authed: true, agent: agentInstalled_(), telegram: telegramEnabled_(), storage: true, keySet: !!secret_('GEMINI_API_KEY'), platform: 'gas', account: account_(), sheet: sheetInfo_(),
    vapidPublicKey: vapidKeys_().publicKey, pushSubs: pushSubs_().length };
}
function apiGetState() { return JSON.stringify(readState_()); }
function apiPutState(patchJson) { return JSON.stringify(setState_(JSON.parse(patchJson))); }
function apiQuotes(tickers) { return JSON.stringify(getQuotes_(tickers)); }

/** Secrets typed in the app's settings. Empty values are ignored (existing ones are kept). */
function apiSaveSecrets(s) {
  var p = props_();
  ['GEMINI_API_KEY', 'TELEGRAM_BOT_TOKEN', 'TELEGRAM_CHAT_ID'].forEach(function (k) {
    if (s && typeof s[k] === 'string' && s[k].trim()) p.setProperty(k, s[k].trim());
  });
  if (s && s.clearTelegram) { p.deleteProperty('TELEGRAM_BOT_TOKEN'); p.deleteProperty('TELEGRAM_CHAT_ID'); }
  ensureAgent_();
  return apiHealth();
}
function apiTestTelegram() {
  if (!telegramEnabled_()) throw apiError_('telegram_off', 'טלגרם לא מוגדר');
  if (!telegramSend_('SwingPulse · בדיקה: ההתראות לטלגרם עובדות.')) throw apiError_('telegram_failed', 'השליחה נכשלה. בדקו את הטוקן ואת ה-Chat ID');
  return true;
}

/** One chunk of screenshots ([{mimeType, data(base64)}]) → extraction JSON for that chunk. */
function apiExtractChunk(images, start, total, market) {
  var note = '\n(Screenshots ' + (start + 1) + '–' + (start + images.length) + ' of ' + total + '.)';
  var il = market === 'IL';
  var parts = [{ text: (il ? EXTRACTION_PROMPT_IL : EXTRACTION_PROMPT) + note }].concat(images.map(function (img) { return { inlineData: { mimeType: img.mimeType || 'image/jpeg', data: img.data } }; }));
  var r = geminiGenerate_({ contents: [{ role: 'user', parts: parts }], generationConfig: { responseMimeType: 'application/json', responseJsonSchema: EXTRACTION_SCHEMA } });
  return il ? JSON.stringify(prepareILChunk(parseJSONLoose_(r.text))) : r.text;
}
/** All chunk results (JSON strings) → one portfolio. */
function apiMergeExtraction(chunkJsons, meta) {
  var merged = mergeChunks(chunkJsons.map(function (j) { return JSON.parse(j); }));
  if (meta && meta.market === 'IL') { merged.currency = 'ILS'; merged.market = 'IL'; }
  merged.meta = Object.assign({}, merged.meta, meta || {}, { model: secret_('GEMINI_MODEL') || DEFAULT_MODEL });
  return JSON.stringify(merged);
}

/** Digest. opts: { save, trigger }. With save the digest + alerts are stored and sent to Telegram. */
function apiDigest(portfolioJson, opts) {
  var pf = JSON.parse(portfolioJson);
  var il = opts && opts.il && opts.il.positions && opts.il.positions.length ? opts.il : null;
  if ((!pf || !pf.positions || !pf.positions.length) && !il) throw apiError_('no_positions', 'אין פוזיציות');
  var res = runDigest_(pf && pf.positions && pf.positions.length ? pf : null, null, il);
  var out = res.digest;
  if (opts && opts.save) {
    var st = readState_();
    var prev = opts.trigger === 'import' ? null : st.digest;
    var fresh = buildAlerts(prev, out, bothBooks_(st.portfolio || pf, st.portfolioIL || il), st.settings, opts.trigger || 'manual');
    var meta = Object.assign({}, st.meta, { lastDigestAt: out.meta.at });
    var patch = { digest: out, alerts: fresh.concat(st.alerts || []), meta: meta };
    if (res.portfolio) patch.portfolio = st.portfolio ? applyLiveFrom_(st.portfolio, res.portfolio) : res.portfolio;
    if (res.portfolioIL) patch.portfolioIL = st.portfolioIL ? applyLiveFrom_(st.portfolioIL, res.portfolioIL) : res.portfolioIL;
    setState_(patch);
    notify_(fresh, st.settings);
    out.newAlerts = fresh;
  }
  return JSON.stringify(out);
}
/** One positions list of both books, for alerts that look positions up by ticker. */
function bothBooks_(us, il) {
  return { positions: [].concat((us && us.positions) || [], (il && il.positions) || []) };
}
/** Keep the stored portfolio (it may hold edits) but take the fresh live prices of the digest run. */
function applyLiveFrom_(stored, live) {
  var q = {};
  (live.positions || []).forEach(function (p) { if (p.live) q[String(p.ticker).toUpperCase()] = p.live; });
  return Object.keys(q).length ? applyLive_(stored, q, live.liveAt || new Date().toISOString()) : stored;
}

/* ---------- the agent: a time trigger every 15 minutes ---------- */

function agentInstalled_() {
  return ScriptApp.getProjectTriggers().some(function (t) { return t.getHandlerFunction() === 'agentTick'; });
}
function ensureAgent_() {
  if (!agentInstalled_()) ScriptApp.newTrigger('agentTick').timeBased().everyMinutes(15).create();
}

/** Run once from the editor (▶ setup) to create the sheet, the trigger and approve permissions. */
function setup() {
  stateSheet_();
  ensureAgent_();
  vapidKeys_();
  if (!secret_('APP_TOKEN')) {
    var abc = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789';
    props_().setProperty('APP_TOKEN', randomBytes_(24).map(function (b) { return abc[b % abc.length]; }).join(''));
  }
  console.log('Access code is in Project Settings → Script properties → APP_TOKEN');
  return apiHealth();
}

function agentTick() {
  var t0 = Date.now();
  try { checkOrders_(); } catch (e) { console.warn('orders: ' + redact_(String(e.message || e))); }
  var st = readState_();
  if (!allTickers_(st).length) return;
  var now = new Date();
  var open = isUsMarketOpen(now) || isTaseOpen(now);
  var meta = st.meta || {};
  var lastQ = meta.lastQuotesAt ? new Date(meta.lastQuotesAt).getTime() : 0;

  if (open || now.getTime() - lastQ > 60 * 60e3) {
    try {
      var q = quotesWithFx_(allTickers_(st));
      if (Object.keys(q.quotes).length) {
        st = setState_(function (cur) {
          if (!cur.portfolio && !cur.portfolioIL) return null;
          return Object.assign(liveBooks_(cur, q), { meta: Object.assign({}, cur.meta, { lastQuotesAt: q.at, fx: q.fx.live ? q.fx : (cur.meta || {}).fx }) });
        });
        meta = st.meta || {};
      }
    } catch (e) { console.warn('agent quotes: ' + e.message); }
  }

  if (open && (st.settings.alertTypes || {}).stop !== false) {
    var stops = [];
    st = setState_(function (cur) {
      stops = stopAlerts(bothBooks_(cur.portfolio, cur.portfolioIL), cur.digest, cur.alerts, now);
      return stops.length ? { alerts: stops.concat(cur.alerts || []) } : null;
    });
    if (stops.length) notify_(stops, st.settings);
  }

  // after a failure: wait 30 min, then 1h, 2h, 4h. The attempt is written BEFORE calling Gemini,
  // so even Apps Script's 6-minute kill can't make it retry every 15 minutes.
  var fails = meta.digestFails || 0;
  var waitOk = !meta.lastDigestTryAt || now.getTime() - new Date(meta.lastDigestTryAt).getTime() >= 30 * 60e3 * Math.pow(2, Math.min(3, Math.max(0, fails - 1)));
  if (digestDue(st.settings, meta.lastDigestAt, now) && waitOk && secret_('GEMINI_API_KEY')) {
    setState_(function (cur) { return { meta: Object.assign({}, cur.meta, { lastDigestTryAt: now.toISOString(), digestFails: (cur.meta && cur.meta.digestFails || 0) + 1 }) }; });
    try {
      var res = runDigest_(st.portfolio, { light: true, deadline: t0 + 5 * 60e3 }, st.portfolioIL);
      var fresh = [];
      var cur2 = setState_(function (cur) {
        fresh = buildAlerts(cur.digest, res.digest, bothBooks_(cur.portfolio, cur.portfolioIL), cur.settings, 'auto');
        var m = Object.assign({}, cur.meta, { lastDigestAt: res.digest.meta.at });
        delete m.lastDigestTryAt; delete m.digestFails; delete m.lastDigestError;
        return { digest: res.digest, alerts: fresh.concat(cur.alerts || []), meta: m };
      });
      notify_(fresh, cur2.settings);
    } catch (e) {
      setState_(function (cur) { return { meta: Object.assign({}, cur.meta, { lastDigestError: redact_(String(e.message)).slice(0, 300) }) }; });
    }
  }
}

/* ---------- demo mode ("point zero"): a separate 30-day paper portfolio, never touches the real one ---------- */

var DEMO_KEYS = ['portfolio', 'portfolioIL', 'zero', 'digest', 'orders', 'updatedAt'];
var DEMO_HISTORY_HEAD = ['זמן', 'פעולה', 'מניה', 'כמות', 'מחיר', 'סכום', 'רווח ממומש', 'מקור', 'הערה'];

function hiddenSheet_(name) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(name);
  if (!sh) { sh = ss.insertSheet(name); sh.hideSheet(); }
  return sh;
}

function readDemo_() {
  var sh = hiddenSheet_('_demo');
  var out = { portfolio: null, portfolioIL: null, zero: null, digest: null, updatedAt: null };
  if (!sh.getLastRow()) return out;
  sh.getDataRange().getValues().forEach(function (row) {
    if (DEMO_KEYS.indexOf(row[0]) < 0) return;
    var json = row.slice(1).join('');
    if (!json) return;
    try { out[row[0]] = JSON.parse(json); } catch (e) { /* corrupt cell: keep default */ }
  });
  return out;
}

function setDemo_(patch) {
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    var sh = hiddenSheet_('_demo');
    var d = readDemo_();
    if (typeof patch === 'function') { patch = patch(d); if (!patch) return d; }
    Object.keys(patch).forEach(function (k) {
      if (DEMO_KEYS.indexOf(k) < 0 || k === 'updatedAt') return;
      d[k] = patch[k];
      writeKey_(sh, k, patch[k]);
    });
    d.updatedAt = new Date().toISOString();
    writeKey_(sh, 'updatedAt', d.updatedAt);
    if ('portfolio' in patch || 'digest' in patch) writePortfolioSheet_(d.portfolio, d.digest, 'תיק_דמו');
    if ('portfolioIL' in patch || 'digest' in patch) writePortfolioSheet_(d.portfolioIL, d.digest, 'תיק_דמו_ישראל');
    return d;
  } finally { lock.releaseLock(); }
}

function demoHistorySheet_() {
  var sh = hiddenSheet_('_demo_history');
  if (!sh.getLastRow()) sh.getRange(1, 1, 1, DEMO_HISTORY_HEAD.length).setValues([DEMO_HISTORY_HEAD]);
  return sh;
}

function logDemo_(entries) {
  if (!entries || !entries.length) return;
  var sh = demoHistorySheet_();
  var rows = entries.map(function (e) {
    return [e.at, TRADE_HE[e.type] || e.type, e.ticker || '', e.shares == null ? '' : e.shares, e.price == null ? '' : e.price,
      e.amount == null ? '' : e.amount, e.realized == null ? '' : e.realized, e.source || '', e.note || ''];
  });
  sh.getRange(sh.getLastRow() + 1, 1, rows.length, DEMO_HISTORY_HEAD.length).setValues(rows);
}

function readDemoHistory_(limit) {
  var sh = demoHistorySheet_();
  var last = sh.getLastRow();
  if (last < 2) return [];
  var from = Math.max(2, last - (limit || 60) + 1);
  return sh.getRange(from, 1, last - from + 1, DEMO_HISTORY_HEAD.length).getValues().reverse().map(function (r) {
    return { at: r[0], action: r[1], ticker: r[2], shares: r[3], price: r[4], amount: r[5], realized: r[6], source: r[7], note: r[8] };
  });
}

function demoView_() {
  var d = readDemo_();
  d.history = d.zero ? readDemoHistory_(60) : [];
  return d;
}

/** Point zero: copy the real portfolio (with live prices) into the demo and start the history over. */
function demoReset_() {
  var real = readState_();
  if (!allTickers_(real).length) throw apiError_('no_positions', 'אין תיק אמיתי להעתיק. קודם מייבאים מבלינק או מהבנק.');
  var books = JSON.parse(JSON.stringify({ portfolio: real.portfolio, portfolioIL: real.portfolioIL }));
  try {
    var q = getQuotes_(allTickers_(books));
    if (Object.keys(q.quotes).length) books = Object.assign(books, liveBooks_(books, q));
  } catch (e) { console.warn('demo quotes: ' + e.message); }
  var at = new Date().toISOString();
  var demo = books.portfolio ? demoBook_(books.portfolio, at, 'USD') : null;
  var demoIL = books.portfolioIL ? demoBook_(books.portfolioIL, at, 'ILS') : null;
  var zeroOf = function (b) { return b ? b.positions.map(function (p) { return { ticker: p.ticker, shares: p.shares, avgPrice: p.avgPrice, price: p.currentPrice }; }) : []; };
  var zero = {
    at: at, total: demo ? demo.totalPortfolioValue : 0, cash: demo ? demo.cashBalance : 0, realTotal: demo ? demo.totalPortfolioValue : 0,
    totalIL: demoIL ? demoIL.totalPortfolioValue : 0, cashIL: demoIL ? demoIL.cashBalance : 0,
    positions: zeroOf(demo).concat(zeroOf(demoIL))
  };
  var count = (demo ? demo.positions.length : 0) + (demoIL ? demoIL.positions.length : 0);
  var sh = demoHistorySheet_();
  sh.clearContents();
  sh.getRange(1, 1, 1, DEMO_HISTORY_HEAD.length).setValues([DEMO_HISTORY_HEAD]);
  logDemo_([{ at: at, type: 'נקודת אפס', ticker: '', amount: zero.total, source: 'system', note: count + ' מניות הועתקו מהתיק האמיתי' }]);
  setDemo_({ portfolio: demo, portfolioIL: demoIL, zero: zero, digest: real.digest || null, orders: [] });
  return demoView_();
}

function demoBook_(pf, at, currency) {
  return recomputePortfolio({
    positions: pf.positions.map(function (p) {
      return { ticker: p.ticker, companyName: p.companyName, shares: p.shares, avgPrice: p.avgPrice, currentPrice: p.currentPrice, live: p.live || null };
    }),
    cashBalance: Number(pf.cashBalance) || 0, currency: pf.currency || currency, realizedPnl: 0, importedAt: at, liveAt: pf.liveAt || null, liveCount: pf.liveCount || 0
  });
}

/* ---------- trades: free text → checked trades → applied to the real or the demo portfolio ---------- */

/** Every write names its book explicitly. Anything else is refused, so a demo action can never fall through to the real portfolio. */
function strictMode_(mode) {
  if (mode === 'live' || mode === 'demo') return mode;
  throw apiError_('bad_mode', 'חסר מצב (live / demo). שום דבר לא עודכן.');
}

/** Both books of a mode: { portfolio, portfolioIL }. */
function holderFor_(mode) {
  if (strictMode_(mode) === 'demo') {
    var d = readDemo_();
    if (!d.zero) throw apiError_('no_demo', 'מצב הדמו עוד לא התחיל.');
    return d;
  }
  return readState_();
}
function portfolioFor_(mode, market) {
  var h = holderFor_(mode);
  return h[bookKey(market || 'US')] || emptyBook(market || 'US');
}

/** Trades go to the book of their market (a .TA symbol → the Tel Aviv book, in ₪). Returns the patch and the merged results. */
function applyBooks_(h, trades, source) {
  var by = tradesByMarket(trades), patch = {}, results = [], log = [];
  MARKETS.forEach(function (m) {
    if (!by[m].length) return;
    var key = bookKey(m);
    var r = applyTrades(h[key] || emptyBook(m), by[m], { source: source });
    results = results.concat(r.results);
    log = log.concat(r.log);
    if (r.log.length) patch[key] = r.portfolio;
  });
  return { patch: patch, results: results, log: log };
}

function parseTrade_(text, mode) {
  if (!String(text || '').trim()) throw apiError_('bad_request', 'ההודעה ריקה');
  var h = holderFor_(mode);
  var r = geminiGenerate_({
    contents: [{ role: 'user', parts: [{ text: tradeParsePrompt(text, bothBooksForPrompt(h.portfolio, h.portfolioIL)) }] }],
    generationConfig: { responseMimeType: 'application/json', responseJsonSchema: TRADE_PARSE_SCHEMA }
  }, { json: true });
  var parsed = cleanParsedTrades(r.data);
  var need = parsed.trades.filter(function (t) { return !(t.price > 0); }).map(function (t) { return t.ticker; });
  var quotes = need.length ? getQuotes_(need).quotes : {};
  parsed.trades.forEach(function (t) {
    if (!(t.price > 0) && quotes[t.ticker] && quotes[t.ticker].price > 0) { t.price = quotes[t.ticker].price; t.priceSource = 'live'; }
    if (!(t.shares > 0) && t.amount > 0 && t.price > 0 && t.type !== 'SELL_ALL') t.shares = Math.floor(t.amount / t.price * 10000) / 10000;
  });
  var previews = applyBooks_(h, parsed.trades, 'chat').results;   // each preview sees the trades before it, in its own book
  previews.forEach(function (p) { if (p.trade) p.trade.market = marketOf(p.trade.ticker); });
  return { mode: mode, reply: parsed.reply, trades: parsed.trades, previews: previews, model: r.model };
}

function applyTrades_(trades, mode, source) {
  mode = strictMode_(mode);
  if (!Array.isArray(trades) || !trades.length) throw apiError_('bad_request', 'אין פעולות לביצוע');
  if (mode === 'demo') {
    var res = null;
    setDemo_(function (d) {
      if (!d.zero) throw apiError_('no_demo', 'מצב הדמו עוד לא התחיל.');
      res = applyBooks_(d, trades, source || 'chat');
      if (!res.log.length) throw apiError_('trade_failed', res.results.map(function (x) { return x.error; }).filter(Boolean).join(' '));
      return res.patch;
    });
    logDemo_(res.log);
    return { mode: 'demo', results: res.results, log: res.log, demo: demoView_() };
  }
  var out = null;
  var saved = setState_(function (st) {
    if (!st.portfolio && !st.portfolioIL) throw apiError_('no_positions', 'אין תיק אמיתי. קודם מייבאים מבלינק או מהבנק.');
    out = applyBooks_(st, trades, source || 'chat');
    if (!out.log.length) throw apiError_('trade_failed', out.results.map(function (x) { return x.error; }).filter(Boolean).join(' '));
    return Object.assign({}, out.patch, { meta: Object.assign({}, st.meta, { trades: out.log.concat((st.meta && st.meta.trades) || []).slice(0, 100) }) });
  });
  return { mode: 'live', results: out.results, log: out.log, portfolio: saved.portfolio, portfolioIL: saved.portfolioIL, updatedAt: saved.updatedAt };
}

/* ---------- manual trades and limit orders (live and demo keep separate order books) ---------- */

function ordersOf_(mode) { return ((mode === 'demo' ? readDemo_().orders : readState_().orders) || []); }
/** change(list) → new list, run on the order book as it is inside the lock. */
function saveOrders_(mode, change) {
  mode = strictMode_(mode);
  var list;
  var apply = function (book) {
    list = change((book.orders || []).slice()).filter(function (o) { return o.status === 'open' || o.status === 'triggered' || Date.now() - new Date(o.doneAt || o.at).getTime() < 7 * 864e5; }).slice(-50);
    return { orders: list };
  };
  if (mode === 'demo') setDemo_(apply); else setState_(apply);
  return list;
}
function markOrder_(mode, id, patch) {
  return saveOrders_(mode, function (l) { return l.map(function (o) { return o.id === id ? Object.assign({}, o, patch) : o; }); });
}
function errText_(e) {
  var m = String((e && e.message) || e);
  try { var j = JSON.parse(m); if (j && j.message) return j.message; } catch (x) { /* plain */ }
  return m;
}

function cleanOrder_(o) {
  o = o || {};
  var t = { type: String(o.type || ''), ticker: String(o.ticker || '').trim().toUpperCase(), shares: Number(o.shares), price: Number(o.price),
    orderType: o.orderType === 'LIMIT' ? 'LIMIT' : 'MARKET' };
  if (TRADE_TYPES.indexOf(t.type) < 0) throw apiError_('bad_request', 'סוג פעולה לא מוכר');
  if (!/^[A-Z0-9.\-]{1,12}$/.test(t.ticker)) throw apiError_('bad_request', 'סימול מניה לא תקין');
  if (!(t.price > 0)) throw apiError_('bad_request', 'מחיר לא תקין');
  if (t.type !== 'SELL_ALL' && !(t.shares > 0)) throw apiError_('bad_request', 'כמות לא תקינה');
  return t;
}

/** Market: applied now at the given price. Limit: kept open until the price reaches it (checked every 15 minutes). */
function placeOrder_(o, mode) {
  mode = strictMode_(mode);
  var t = cleanOrder_(o);
  if (t.orderType === 'MARKET') {
    var r = applyTrades_([{ type: t.type, ticker: t.ticker, shares: t.shares, price: t.price }], mode, 'ידני');
    r.orders = ordersOf_(mode);
    return r;
  }
  var pv = previewTrade(portfolioFor_(mode, marketOf(t.ticker)), { type: t.type, ticker: t.ticker, shares: t.shares, price: t.price });
  if (!pv.ok) throw apiError_('trade_failed', pv.error);
  var order = { id: Utilities.getUuid().slice(0, 8), type: t.type, ticker: t.ticker, shares: pv.trade.shares, limit: t.price, status: 'open', at: new Date().toISOString() };
  return { mode: mode, order: order, orders: saveOrders_(mode, function (l) { return l.concat([order]); }) };
}

